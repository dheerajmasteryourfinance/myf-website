# Master Your Finance: Hostinger (Apache/LiteSpeed) settings
DirectoryIndex index.html
Options -Indexes -MultiViews

RewriteEngine On

# Always https://masteryourfinance.org (no http, no www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://masteryourfinance.org/$1 [L,R=301]

# ---- Clean addresses: /services, /about-us, /contact-us ... ----
# Old page addresses (and old WordPress links) -> new clean ones
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteRule ^about(\.html)?/?$ /about-us [L,R=301,NC]
RewriteRule ^(book|book-a-call|contact)(\.html)?/?$ /contact-us [L,R=301,NC]
RewriteRule ^(resources|tools-and-resources)/?$ /tools [L,R=301,NC]
RewriteRule ^health-check/index\.html$ /health-check [L,R=301,NC]
# Any other page.html typed in the browser -> page (page code files are left alone)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteCond %1 !\.dc$ [NC]
RewriteRule ^ /%1 [L,R=301]
# Drop a trailing slash: /services/ -> /services (real folders like /assets/ keep theirs)
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]
# Serve /services from services.html (inside the server, address stays clean)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L,NC]

# Hide files that are not part of the website
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/scripts/
RedirectMatch 404 ^/(README\.md|myf-config\.example\.php|\.gitignore|\.nojekyll)$

ErrorDocument 404 /index.html

# Faster loading
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
